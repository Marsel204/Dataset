{
  "serial_interface": {
    "port": "/dev/ttyTHS1",
    "fallback_ports": [
      "/dev/ttyUSB0",
      "/dev/ttyACM0"
    ],
    "baudrate": 115200,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout_sec": 0.1,
    "write_timeout_sec": 0.5,
    "mock_mode": false
  },
  "watchdog": {
    "heartbeat_interval_sec": 1.0,
    "heartbeat_timeout_sec": 3.0,
    "max_consecutive_misses": 3,
    "failsafe_mode": "FLASHING_YELLOW",
    "failsafe_fixed_green_sec": 30.0
  },
  "packet_protocol": {
    "start_byte": "0xAA",
    "end_byte": "0x55",
    "commands": {
      "actuate_green_duration": "0x01",
      "watchdog_heartbeat": "0x02",
      "failsafe_override": "0x03",
      "status_request": "0x04"
    },
    "checksum_type": "CRC8"
  }
}
